import requests
import json
from function_library import (
    log_blocked_ip,
    quarantine_host,
    flag_suspicious_ip,
    alert_admin,
    log_clear,
    ATTACK_FUNCTION_MAP,
    FUNCTION_REGISTRY,
)

# ─────────────────────────────────────────────────────────────
#  CONFIG
# ─────────────────────────────────────────────────────────────

MODEL   = "gpt-oss:120b-cloud"
OLLAMA  = "http://localhost:11434/api/generate"
TIMEOUT = 120

# Action functions available to this agent only
# Investigation functions are NOT available here
ACTION_FUNCTIONS = {
    "log_blocked_ip"    : log_blocked_ip,
    "quarantine_host"   : quarantine_host,
    "flag_suspicious_ip": flag_suspicious_ip,
    "alert_admin"       : alert_admin,
    "log_clear"         : log_clear,
}

# Severity → auto-escalation rules
# If severity is critical, some actions are mandatory
MANDATORY_ACTIONS = {
    "CRITICAL": ["alert_admin"],
    "HIGH"    : ["alert_admin"],
    "MEDIUM"  : [],
    "LOW"     : [],
}


# ─────────────────────────────────────────────────────────────
#  CORE LLM CALL
# ─────────────────────────────────────────────────────────────

def call_ollama(prompt: str) -> str:
    try:
        r = requests.post(
            OLLAMA,
            json={"model": MODEL, "prompt": prompt, "stream": False},
            timeout=TIMEOUT
        )
        r.raise_for_status()
        return r.json().get("response", "").strip()
    except requests.exceptions.RequestException as e:
        print(f"  [Ollama error] {e}")
        return ""


# ─────────────────────────────────────────────────────────────
#  PARSE DECISION RESPONSE
# ─────────────────────────────────────────────────────────────

def parse_decision_response(response: str) -> dict:
    """
    Parses agent output looking for:
    THOUGHT: ...
    VERDICT: BLOCK | PATCH | ALERT | MONITOR | CLEAR
    ACTIONS: func1, func2, ...
    REASON: ...
    NEEDS_HUMAN: YES | NO
    """
    result = {
        "thought"     : "",
        "verdict"     : "",
        "actions"     : [],
        "reason"      : "",
        "needs_human" : True,
        "raw"         : response
    }

    for line in response.splitlines():
        line = line.strip()
        if line.upper().startswith("THOUGHT:"):
            result["thought"] = line.split(":", 1)[1].strip()
        elif line.upper().startswith("VERDICT:"):
            result["verdict"] = line.split(":", 1)[1].strip().upper()
        elif line.upper().startswith("ACTIONS:"):
            actions_str = line.split(":", 1)[1].strip()
            result["actions"] = [a.strip() for a in actions_str.split(",")]
        elif line.upper().startswith("REASON:"):
            result["reason"] = line.split(":", 1)[1].strip()
        elif line.upper().startswith("NEEDS_HUMAN:"):
            val = line.split(":", 1)[1].strip().upper()
            result["needs_human"] = val != "NO"

    return result


# ─────────────────────────────────────────────────────────────
#  EXECUTE ACTION FUNCTION
# ─────────────────────────────────────────────────────────────

def execute_action_function(
    action      : str,
    features    : dict,
    attack_label: str,
    severity    : str,
    confidence  : float
) -> str:
    """
    Calls the named action function with appropriate arguments
    derived from the alert context.
    """
    if action not in ACTION_FUNCTIONS:
        return f"[Unknown action function: {action}]"

    func = ACTION_FUNCTIONS[action]

    # Source IP — use destination port as proxy since
    # CICIDS2017 doesn't have raw IPs
    source_ip = f"suspicious_host_port_{features.get('Destination Port', 'unknown')}"

    try:
        if action == "log_blocked_ip":
            return func(source_ip, f"{attack_label} detected with {confidence:.2%} confidence")

        elif action == "quarantine_host":
            return func(source_ip, f"{attack_label} — host quarantined by decision agent")

        elif action == "flag_suspicious_ip":
            return func(source_ip, attack_label, confidence)

        elif action == "alert_admin":
            details = (
                f"Attack: {attack_label} | "
                f"Confidence: {confidence:.2%} | "
                f"Severity: {severity} | "
                f"Port: {features.get('Destination Port', 'N/A')} | "
                f"Flow: {features.get('Flow Bytes/s', 'N/A')} B/s"
            )
            return func(attack_label, severity, details)

        elif action == "log_clear":
            return func(f"Traffic verified BENIGN by decision agent. Confidence: {confidence:.2%}")

        else:
            return f"[No execution logic for: {action}]"

    except Exception as e:
        return f"[Action error: {e}]"


# ─────────────────────────────────────────────────────────────
#  DECISION AGENT
#  Receives investigation context from Investigator Agent.
#  Decides verdict + which action functions to call.
#  Executes them and returns action log.
# ─────────────────────────────────────────────────────────────

def run_decision_agent(investigation_context: dict) -> dict:
    """
    Takes the full investigation context from the Investigator Agent.
    Decides verdict and executes appropriate action functions.

    Returns enriched context with:
    - verdict
    - reason
    - actions_taken (list of action + result pairs)
    - needs_human
    """

    sep = "─" * 52
    print(f"\n{sep}")
    print(f"  [DECISION AGENT] Analysing investigation results")
    print(sep)

    attack_label = investigation_context["attack_label"]
    confidence   = investigation_context["confidence"]
    features     = investigation_context["features"]
    severity     = investigation_context["severity"]
    summary      = investigation_context["summary"]
    trace        = investigation_context["trace"]

    # Format the investigation trace for the LLM
    trace_text = ""
    for step in trace:
        trace_text += f"\n  Step {step['step']}:"
        if "thought"    in step: trace_text += f"\n    Thought     : {step['thought']}"
        if "action"     in step: trace_text += f"\n    Action      : {step['action']}"
        if "observation"in step: trace_text += f"\n    Observation : {step['observation']}"
        if "conclusion" in step: trace_text += f"\n    Conclusion  : {step['conclusion']}"

    available_actions = ", ".join(ACTION_FUNCTIONS.keys())

    system_prompt = f"""You are a cybersecurity decision agent in a Security Operations Center.
You have received a completed investigation report from the Investigator Agent.
Your job is to decide the appropriate response and which action functions to execute.

INVESTIGATION SUMMARY:
- Attack type  : {attack_label}
- Confidence   : {confidence:.2%}
- Severity     : {severity}
- Summary      : {summary}

INVESTIGATION TRACE:
{trace_text}

KEY FEATURES:
- Destination Port : {features.get('Destination Port', 'N/A')}
- Flow Bytes/s     : {features.get('Flow Bytes/s', 'N/A')}
- SYN Flag Count   : {features.get('SYN Flag Count', 'N/A')}

AVAILABLE ACTION FUNCTIONS: {available_actions}

ACTION GUIDELINES:
- BLOCK verdict   → use log_blocked_ip + alert_admin
- MONITOR verdict → use flag_suspicious_ip + alert_admin
- QUARANTINE      → use quarantine_host + alert_admin
- ALERT only      → use alert_admin only
- CLEAR           → use log_clear only

SEVERITY GUIDELINES:
- CRITICAL → mandatory alert_admin, recommend immediate block
- HIGH     → alert_admin + blocking/quarantine
- MEDIUM   → flag + alert
- LOW      → flag only or monitor

Respond in EXACTLY this format:
THOUGHT: <your reasoning based on the investigation findings>
VERDICT: <BLOCK | QUARANTINE | MONITOR | ALERT | CLEAR>
ACTIONS: <comma separated list of action functions to call>
REASON: <one sentence explaining your verdict>
NEEDS_HUMAN: <YES if high severity or destructive action | NO if low risk>
"""

    print("  Calling LLM for decision...")
    response = call_ollama(system_prompt)

    if not response:
        print("  [Warning] No LLM response — falling back to rule-based decision")
        # Rule-based fallback if LLM fails
        if "CRITICAL" in severity or "HIGH" in severity:
            verdict  = "BLOCK"
            actions  = ["log_blocked_ip", "alert_admin"]
            reason   = "High severity attack — automatic block applied"
            needs_human = True
        elif attack_label == "BENIGN":
            verdict  = "CLEAR"
            actions  = ["log_clear"]
            reason   = "Traffic verified as benign"
            needs_human = False
        else:
            verdict  = "MONITOR"
            actions  = ["flag_suspicious_ip", "alert_admin"]
            reason   = "Moderate risk — flagged for monitoring"
            needs_human = True
    else:
        parsed      = parse_decision_response(response)
        verdict     = parsed["verdict"] or "MONITOR"
        actions     = parsed["actions"]
        reason      = parsed["reason"]
        needs_human = parsed["needs_human"]

        print(f"  [Thought]     {parsed['thought']}")
        print(f"  [Verdict]     {verdict}")
        print(f"  [Actions]     {actions}")
        print(f"  [Reason]      {reason}")
        print(f"  [Needs human] {needs_human}")

    # Ensure mandatory actions are included based on severity
    severity_level = "LOW"
    for level in ["CRITICAL", "HIGH", "MEDIUM", "LOW"]:
        if level in severity.upper():
            severity_level = level
            break

    for mandatory in MANDATORY_ACTIONS.get(severity_level, []):
        if mandatory not in actions:
            print(f"  [Auto-add] {mandatory} — mandatory for {severity_level}")
            actions.append(mandatory)

    # Execute all action functions
    print(f"\n  Executing {len(actions)} action(s)...")
    actions_taken = []

    for action in actions:
        if not action:
            continue
        print(f"  → Executing: {action}")
        result = execute_action_function(
            action, features, attack_label, severity, confidence
        )
        print(f"    Result: {result[:100]}")
        actions_taken.append({
            "action": action,
            "result": result
        })

    print(f"\n  [DECISION AGENT DONE]")
    print(f"  Verdict      : {verdict}")
    print(f"  Actions taken: {len(actions_taken)}")
    print(f"  Needs human  : {needs_human}")
    print(sep)

    # Return enriched context for Synthesis Agent
    return {
        **investigation_context,
        "verdict"      : verdict,
        "reason"       : reason,
        "actions_taken": actions_taken,
        "needs_human"  : needs_human,
    }


