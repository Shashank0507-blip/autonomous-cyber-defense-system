import requests
import json
from function_library import (
    check_port_history,
    check_flow_rate,
    check_syn_count,
    lookup_threat_intel,
    get_similar_incidents,
    calculate_severity,
    ATTACK_FUNCTION_MAP,
)

# ─────────────────────────────────────────────────────────────
#  CONFIG
# ─────────────────────────────────────────────────────────────

MODEL   = "gpt-oss:120b-cloud"
OLLAMA  = "http://localhost:11434/api/generate"
TIMEOUT = 120

# Investigation functions available to this agent
# These are READ-ONLY — no action functions here
# Action functions are reserved for the Decision Agent
INVESTIGATION_FUNCTIONS = {
    "check_port_history"   : check_port_history,
    "check_flow_rate"      : check_flow_rate,
    "check_syn_count"      : check_syn_count,
    "lookup_threat_intel"  : lookup_threat_intel,
    "get_similar_incidents": get_similar_incidents,
    "calculate_severity"   : calculate_severity,
}


# ─────────────────────────────────────────────────────────────
#  CORE LLM CALL
# ─────────────────────────────────────────────────────────────

def call_ollama(prompt: str) -> str:
    try:
        r = requests.post(
            OLLAMA,
            json={"model": MODEL, "prompt": prompt, "stream": False},
            timeout=TIMEOUT
        )
        r.raise_for_status()
        return r.json().get("response", "").strip()
    except requests.exceptions.RequestException as e:
        print(f"  [Ollama error] {e}")
        return ""


# ─────────────────────────────────────────────────────────────
#  PARSE AGENT RESPONSE
#  Agent outputs structured lines we parse into actions
# ─────────────────────────────────────────────────────────────

def parse_agent_response(response: str) -> dict:
    """
    Parses agent output looking for:
    THOUGHT: ...
    ACTION: function_name
    ARGS: arg1, arg2, ...
    ANSWER: final conclusion
    """
    result = {
        "thought": "",
        "action" : "",
        "args"   : [],
        "answer" : "",
        "raw"    : response
    }

    for line in response.splitlines():
        line = line.strip()
        if line.upper().startswith("THOUGHT:"):
            result["thought"] = line.split(":", 1)[1].strip()
        elif line.upper().startswith("ACTION:"):
            result["action"] = line.split(":", 1)[1].strip()
        elif line.upper().startswith("ARGS:"):
            args_str = line.split(":", 1)[1].strip()
            result["args"] = [a.strip() for a in args_str.split(",")]
        elif line.upper().startswith("ANSWER:"):
            result["answer"] = line.split(":", 1)[1].strip()

    return result


# ─────────────────────────────────────────────────────────────
#  EXECUTE INVESTIGATION FUNCTION
#  Calls the right function with the right arguments
#  extracted from the agent's response
# ─────────────────────────────────────────────────────────────

def execute_investigation_function(action: str, args: list, features: dict) -> str:
    """
    Calls the named investigation function.
    Falls back to feature values if args are missing.
    """
    if action not in INVESTIGATION_FUNCTIONS:
        return f"[Unknown function: {action}]"

    func = INVESTIGATION_FUNCTIONS[action]

    try:
        # Each function knows what it needs — map args intelligently
        if action == "check_port_history":
            port = int(args[0]) if args else int(features.get("Destination Port", 0))
            return func(port)

        elif action == "check_flow_rate":
            rate = float(args[0]) if args else float(features.get("Flow Bytes/s", 0))
            return func(rate)

        elif action == "check_syn_count":
            syn = int(args[0]) if args else int(features.get("SYN Flag Count", 0))
            return func(syn)

        elif action == "lookup_threat_intel":
            attack = args[0] if args else features.get("attack_type", "Unknown")
            return func(attack)

        elif action == "get_similar_incidents":
            attack = args[0] if args else features.get("attack_type", "Unknown")
            return func(attack)

        elif action == "calculate_severity":
            confidence = float(features.get("confidence", 0))
            flow       = float(features.get("Flow Bytes/s", 0))
            syn        = int(features.get("SYN Flag Count", 0))
            port_hits  = int(args[0]) if args else 0
            return func(confidence, flow, syn, port_hits)

        else:
            return f"[No execution logic for: {action}]"

    except Exception as e:
        return f"[Function error: {e}]"


# ─────────────────────────────────────────────────────────────
#  INVESTIGATOR AGENT
#  Runs a Perceive → Reason → Act → Observe loop
#  until it reaches a conclusion or hits max iterations
# ─────────────────────────────────────────────────────────────

def run_investigator(
    attack_label : str,
    confidence   : float,
    features     : dict,
    max_steps    : int = 6
) -> dict:
    """
    Investigates the XGBoost alert by calling investigation
    functions in a reasoning loop.

    Returns a context dict with:
    - attack_label
    - confidence
    - features
    - trace (list of thought/action/observation steps)
    - severity
    - summary (final investigation conclusion)
    """

    sep = "─" * 52
    print(f"\n{sep}")
    print(f"  [INVESTIGATOR] Starting investigation")
    print(f"  Attack : {attack_label} | Confidence : {confidence:.2%}")
    print(sep)

    # Add metadata to features for easy access
    features["attack_type"] = attack_label
    features["confidence"]  = confidence

    # Get suggested functions for this attack type
    suggested = ATTACK_FUNCTION_MAP.get(attack_label, ["lookup_threat_intel"])
    # Only keep investigation functions — filter out action functions
    investigation_only = [
        f for f in suggested
        if f in INVESTIGATION_FUNCTIONS
    ]

    available_functions = ", ".join(INVESTIGATION_FUNCTIONS.keys())

    # Build the initial system prompt
    system_prompt = f"""You are an expert cybersecurity investigator agent in a Security Operations Center.
You have received an alert from an ML-based anomaly detection model.

YOUR GOAL: Investigate this alert thoroughly by calling investigation tools one at a time.
Gather enough evidence to determine the severity and nature of the threat.

ALERT DETAILS:
- Attack type    : {attack_label}
- ML Confidence  : {confidence:.2%}
- Destination Port: {features.get('Destination Port', 'N/A')}
- Flow Bytes/s   : {features.get('Flow Bytes/s', 'N/A')}
- Flow Packets/s : {features.get('Flow Packets/s', 'N/A')}
- SYN Flag Count : {features.get('SYN Flag Count', 'N/A')}
- Down/Up Ratio  : {features.get('Down/Up Ratio', 'N/A')}

AVAILABLE TOOLS: {available_functions}
SUGGESTED TOOLS FOR THIS ATTACK: {', '.join(investigation_only)}

RESPONSE FORMAT — use EXACTLY this format every turn:
THOUGHT: <what you know so far and what you need to find out>
ACTION: <one function name to call>
ARGS: <comma separated arguments, or leave blank to use alert values>

When you have gathered enough evidence, conclude with:
THOUGHT: <final analysis>
ANSWER: <2-3 sentence summary of findings and severity>

Rules:
- Call ONE function per response
- Use the alert values as arguments when not specified
- Stop when you have enough evidence — do not over-investigate
- Never make up function results
"""

    trace      = []
    context    = system_prompt
    severity   = "UNKNOWN"
    summary    = ""

    for step in range(max_steps):
        print(f"\n  [Step {step + 1}/{max_steps}]")

        # Ask agent what to do next
        response = call_ollama(context)
        if not response:
            print("  [Warning] Empty response from LLM")
            break

        parsed = parse_agent_response(response)

        # Agent reached a conclusion
        if parsed["answer"]:
            print(f"  [Conclusion] {parsed['answer']}")
            summary = parsed["answer"]
            trace.append({
                "step"       : step + 1,
                "thought"    : parsed["thought"],
                "conclusion" : parsed["answer"]
            })
            break

        # Agent wants to call a function
        if parsed["action"]:
            action = parsed["action"]
            args   = parsed["args"]
            print(f"  [Thought]    {parsed['thought']}")
            print(f"  [Action]     {action}({', '.join(args)})")

            # Execute the function
            observation = execute_investigation_function(action, args, features)
            print(f"  [Observe]    {observation[:120]}")

            # Extract severity if this was a severity calculation
            if action == "calculate_severity" and "Severity score" in observation:
                severity = observation

            # Log to trace
            trace.append({
                "step"       : step + 1,
                "thought"    : parsed["thought"],
                "action"     : action,
                "args"       : args,
                "observation": observation
            })

            # Feed observation back into context for next iteration
            context += (
                f"\n\nStep {step + 1} result:\n"
                f"THOUGHT: {parsed['thought']}\n"
                f"ACTION: {action}\n"
                f"OBSERVATION: {observation}\n"
                f"\nContinue your investigation or conclude with ANSWER:"
            )
        else:
            print("  [Warning] No action or answer parsed — ending investigation")
            break

    # If no summary generated, ask for one explicitly
    if not summary:
        print("\n  [Investigator] Requesting final summary...")
        summary_prompt = (
            context +
            "\n\nBased on your investigation so far, provide your final conclusion:\n"
            "THOUGHT: <final analysis>\n"
            "ANSWER: <2-3 sentence summary of findings and severity>"
        )
        final = call_ollama(summary_prompt)
        parsed_final = parse_agent_response(final)
        summary = parsed_final.get("answer") or parsed_final.get("thought") or "Investigation complete."

    print(f"\n  [INVESTIGATOR DONE]")
    print(f"  Summary  : {summary}")
    print(f"  Severity : {severity}")
    print(sep)

    return {
        "attack_label": attack_label,
        "confidence"  : confidence,
        "features"    : features,
        "trace"       : trace,
        "severity"    : severity,
        "summary"     : summary,
    }


# ─────────────────────────────────────────────────────────────
#  QUICK TEST
# ─────────────────────────────────────────────────────────────

if __name__ == "__main__":
    test_features = {
        "Destination Port" : 80,
        "Flow Duration"    : 120,
        "Flow Bytes/s"     : 1_500_000.0,
        "Flow Packets/s"   : 2000.0,
        "SYN Flag Count"   : 500,
        "Fwd Packets/s"    : 1800.0,
        "Bwd Packets/s"    : 200.0,
        "Down/Up Ratio"    : 0.1,
    }

    result = run_investigator(
        attack_label = "DDoS",
        confidence   = 0.97,
        features     = test_features
    )

    print("\n\nFull investigation context returned:")
    print(json.dumps(result, indent=2, default=str))
