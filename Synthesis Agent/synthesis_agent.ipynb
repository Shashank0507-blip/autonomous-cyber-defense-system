import requests
import json
import os
from datetime import datetime
from function_library import write_incident_report

# ─────────────────────────────────────────────────────────────
#  CONFIG
# ─────────────────────────────────────────────────────────────

MODEL   = "gpt-oss:120b-cloud"
OLLAMA  = "http://localhost:11434/api/generate"
TIMEOUT = 120


# ─────────────────────────────────────────────────────────────
#  CORE LLM CALL
# ─────────────────────────────────────────────────────────────

def call_ollama(prompt: str) -> str:
    try:
        r = requests.post(
            OLLAMA,
            json={"model": MODEL, "prompt": prompt, "stream": False},
            timeout=TIMEOUT
        )
        r.raise_for_status()
        return r.json().get("response", "").strip()
    except requests.exceptions.RequestException as e:
        print(f"  [Ollama error] {e}")
        return ""


# ─────────────────────────────────────────────────────────────
#  FORMAT TRACE FOR DISPLAY
# ─────────────────────────────────────────────────────────────

def format_trace(trace: list) -> str:
    """Formats the investigation trace into readable text for the LLM."""
    lines = []
    for step in trace:
        lines.append(f"  Step {step.get('step', '?')}:")
        if "thought"     in step: lines.append(f"    Thought     : {step['thought']}")
        if "action"      in step: lines.append(f"    Action      : {step['action']}")
        if "observation" in step: lines.append(f"    Observation : {step['observation']}")
        if "conclusion"  in step: lines.append(f"    Conclusion  : {step['conclusion']}")
    return "\n".join(lines)


def format_actions_taken(actions_taken: list) -> str:
    """Formats the actions taken by the Decision Agent."""
    lines = []
    for i, item in enumerate(actions_taken, 1):
        lines.append(f"  [{i}] {item['action']}")
        lines.append(f"      Result: {item['result'][:100]}")
    return "\n".join(lines)


# ─────────────────────────────────────────────────────────────
#  PARSE SYNTHESIS RESPONSE
# ─────────────────────────────────────────────────────────────

def parse_synthesis_response(response: str) -> dict:
    """
    Parses synthesis agent output looking for:
    SUMMARY: ...
    ATTACK_CLASS: ...
    SEVERITY: ...
    ACTIONS_SUMMARY: ...
    VERDICT: ...
    RECOMMENDATION: ...
    """
    result = {
        "summary"         : "",
        "attack_class"    : "",
        "severity"        : "",
        "actions_summary" : "",
        "verdict"         : "",
        "recommendation"  : "",
        "raw"             : response
    }

    for line in response.splitlines():
        line = line.strip()
        if line.upper().startswith("SUMMARY:"):
            result["summary"] = line.split(":", 1)[1].strip()
        elif line.upper().startswith("ATTACK_CLASS:"):
            result["attack_class"] = line.split(":", 1)[1].strip()
        elif line.upper().startswith("SEVERITY:"):
            result["severity"] = line.split(":", 1)[1].strip()
        elif line.upper().startswith("ACTIONS_SUMMARY:"):
            result["actions_summary"] = line.split(":", 1)[1].strip()
        elif line.upper().startswith("VERDICT:"):
            result["verdict"] = line.split(":", 1)[1].strip()
        elif line.upper().startswith("RECOMMENDATION:"):
            result["recommendation"] = line.split(":", 1)[1].strip()

    return result


# ─────────────────────────────────────────────────────────────
#  PRINT FINAL INCIDENT REPORT TO TERMINAL
# ─────────────────────────────────────────────────────────────

def print_incident_report(report: dict, needs_human: bool):
    sep  = "═" * 52
    sep2 = "─" * 52

    print(f"\n{sep}")
    print(f"  INCIDENT REPORT — {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print(sep)

    print(f"  ML Detection  : {report['attack_type']} ({report['confidence']:.2%} confidence)")
    print(f"  Severity      : {report['severity']}")
    print(f"  Verdict       : {report['verdict']}")

    print(f"\n{sep2}")
    print("  INVESTIGATION TRACE")
    print(sep2)
    for step in report["reasoning_trace"]:
        if "action" in step:
            print(f"  [{step['step']}] {step['action']}")
            print(f"      → {step.get('observation', '')[:80]}")
        elif "conclusion" in step:
            print(f"  [✓] Conclusion: {step['conclusion'][:80]}")

    print(f"\n{sep2}")
    print("  ACTIONS EXECUTED")
    print(sep2)
    for i, item in enumerate(report["actions_taken"], 1):
        print(f"  [{i}] {item['action']}")
        print(f"      → {item['result'][:80]}")

    print(f"\n{sep2}")
    print("  SYNTHESIS")
    print(sep2)
    print(f"  Summary       : {report['synthesis']['summary']}")
    print(f"  Attack Class  : {report['synthesis']['attack_class']}")
    print(f"  Recommendation: {report['synthesis']['recommendation']}")

    print(f"\n{sep}")
    if needs_human:
        print("  ⚠  HUMAN APPROVAL REQUIRED")
    else:
        print("  ✓  AUTO-RESOLVED — No human action needed")
    print(sep)


# ─────────────────────────────────────────────────────────────
#  HUMAN APPROVAL LAYER
# ─────────────────────────────────────────────────────────────

def get_human_decision(verdict: str, attack_label: str) -> str:
    """Prompts human for approval and returns their decision."""
    print(f"\n  Recommended action : {verdict}")
    print(f"  Attack detected    : {attack_label}")
    decision = input("\n  Approve recommended action? (y/n): ").strip().lower()
    if decision == "y":
        print("  [APPROVED] Action confirmed.")
        return "approved"
    else:
        print("  [REJECTED] Action overridden by human. Logged for review.")
        return "rejected"


# ─────────────────────────────────────────────────────────────
#  SYNTHESIS AGENT
#  Reads full context from both previous agents.
#  Generates clean incident report.
#  Handles human approval.
#  Saves everything to disk.
# ─────────────────────────────────────────────────────────────

def run_synthesis_agent(decision_context: dict) -> dict:
    """
    Takes full enriched context from Decision Agent.
    Synthesises a clean incident report.
    Gets human approval if needed.
    Saves report to disk.

    Returns final complete context with human decision.
    """

    sep = "─" * 52
    print(f"\n{sep}")
    print(f"  [SYNTHESIS AGENT] Generating incident report")
    print(sep)

    # Unpack context
    attack_label  = decision_context["attack_label"]
    confidence    = decision_context["confidence"]
    features      = decision_context["features"]
    severity      = decision_context["severity"]
    summary       = decision_context["summary"]
    trace         = decision_context["trace"]
    verdict       = decision_context["verdict"]
    reason        = decision_context["reason"]
    actions_taken = decision_context["actions_taken"]
    needs_human   = decision_context["needs_human"]

    # Format trace and actions for LLM
    trace_text   = format_trace(trace)
    actions_text = format_actions_taken(actions_taken)

    system_prompt = f"""You are a senior cybersecurity incident report writer in a Security Operations Center.
You have received the complete output of a multi-agent cybersecurity investigation.
Your job is to synthesise everything into a concise, structured incident report.

ALERT DETAILS:
- Attack type  : {attack_label}
- Confidence   : {confidence:.2%}
- Severity     : {severity}
- Verdict      : {verdict}
- Reason       : {reason}

INVESTIGATION TRACE:
{trace_text}

ACTIONS EXECUTED:
{actions_text}

INVESTIGATOR SUMMARY:
{summary}

Write a concise synthesis in EXACTLY this format:
SUMMARY: <2 sentence plain English description of what happened>
ATTACK_CLASS: <specific attack category and method>
SEVERITY: <Critical | High | Medium | Low> — <one reason why>
ACTIONS_SUMMARY: <one sentence summarising what was done>
VERDICT: <BLOCK | QUARANTINE | MONITOR | ALERT | CLEAR>
RECOMMENDATION: <one concrete next step for the security team>

Be concise — this report goes directly to the security team.
No essays. No bullet points. Exactly 6 lines.
"""

    print("  Calling LLM for synthesis...")
    response = call_ollama(system_prompt)

    if not response:
        print("  [Warning] No LLM response — using fallback synthesis")
        synthesis = {
            "summary"        : f"{attack_label} detected with {confidence:.2%} confidence. {summary}",
            "attack_class"   : attack_label,
            "severity"       : severity,
            "actions_summary": f"{len(actions_taken)} action(s) executed.",
            "verdict"        : verdict,
            "recommendation" : reason,
            "raw"            : ""
        }
    else:
        synthesis = parse_synthesis_response(response)

    print(f"  [Synthesis done]")

    # Build final report dict
    final_report = {
        "attack_type"    : attack_label,
        "confidence"     : confidence,
        "severity"       : severity,
        "verdict"        : verdict,
        "actions_taken"  : actions_taken,
        "reasoning_trace": trace,
        "synthesis"      : synthesis,
        "key_features"   : features,
    }

    # Print clean terminal report
    print_incident_report(final_report, needs_human)

    # Human approval if needed
    human_decision = "auto-resolved"
    if needs_human:
        human_decision = get_human_decision(verdict, attack_label)

    # Save full report to disk
    print("\n  Saving incident report...")
    save_result = write_incident_report(
        attack_type    = attack_label,
        confidence     = confidence,
        severity       = severity,
        verdict        = verdict,
        trace          = trace,
        features       = features,
        human_decision = human_decision
    )
    print(f"  {save_result}")

    print(f"\n  [SYNTHESIS AGENT DONE]")
    print(sep)

    return {
        **decision_context,
        "synthesis"      : synthesis,
        "human_decision" : human_decision,
        "report_saved"   : save_result
    }


