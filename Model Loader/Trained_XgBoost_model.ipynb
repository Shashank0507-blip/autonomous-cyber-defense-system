import joblib
import numpy as np
import pandas as pd

# ─────────────────────────────────────────────────────────────
#  CONFIG
# ─────────────────────────────────────────────────────────────

MODEL_PATH   = "xgboost_ids_model.pkl"
ENCODER_PATH = "label_encoder.pkl"

SELECTED_FEATURES = [
    "Destination Port",
    "Flow Duration",
    "Total Fwd Packets",
    "Total Backward Packets",
    "Flow Bytes/s",
    "Flow Packets/s",
    "Fwd Packet Length Mean",
    "Fwd Packet Length Std",
    "Bwd Packet Length Mean",
    "Bwd Packet Length Std",
    "SYN Flag Count",
    "FIN Flag Count",
    "RST Flag Count",
    "ACK Flag Count",
    "PSH Flag Count",
    "Down/Up Ratio",
    "Average Packet Size",
    "Avg Fwd Segment Size",
    "Avg Bwd Segment Size",
    "Idle Mean",
    "Idle Std",
    "Idle Max",
    "Idle Min",
]

CONFIDENCE_THRESHOLD = 0.70
LABEL_COLUMN         = "Label"

# ─────────────────────────────────────────────────────────────
#  LOAD MODEL — called once at startup
# ─────────────────────────────────────────────────────────────

def load_model():
    """
    Loads and returns the trained XGBoost model and label encoder.
    Call this once at the start of mas_main.py.
    """
    print("  Loading XGBoost model...")
    model = joblib.load(MODEL_PATH)
    le    = joblib.load(ENCODER_PATH)
    print(f"  Model loaded. Classes: {list(le.classes_)}")
    return model, le


# ─────────────────────────────────────────────────────────────
#  PREPROCESS A DATAFRAME
# ─────────────────────────────────────────────────────────────

def preprocess(df: pd.DataFrame) -> tuple:
    """
    Strips columns, handles inf/NaN, keeps only selected features.
    Returns (X, available_features, df_clean)
    """
    df = df.copy()
    df.columns = df.columns.str.strip()

    available = [c for c in SELECTED_FEATURES if c in df.columns]
    missing   = [c for c in SELECTED_FEATURES if c not in df.columns]
    if missing:
        print(f"  [Warning] Missing columns: {missing}")

    df = df[available].copy()
    df.replace([np.inf, -np.inf], np.nan, inplace=True)
    df.fillna(df.median(numeric_only=True), inplace=True)

    return df, available


# ─────────────────────────────────────────────────────────────
#  PREDICT FROM CSV
#  Main function called by mas_main.py
# ─────────────────────────────────────────────────────────────

def predict_from_csv(
    csv_path  : str,
    model,
    le,
    max_rows  : int = None,
    skip_benign: bool = True
) -> list:
    """
    Reads a CSV file, runs XGBoost predictions on each row.

    Parameters:
    - csv_path   : path to the CSV file
    - model      : loaded XGBoost model
    - le         : loaded LabelEncoder
    - max_rows   : optional limit on rows to process (None = all rows)
    - skip_benign: if True, skips rows predicted as BENIGN

    Returns:
    List of dicts, each containing:
    {
        "features"   : dict of feature values for this row,
        "label"      : predicted attack label (string),
        "confidence" : prediction confidence (float 0-1),
        "row_index"  : original row number in CSV
    }
    Only returns rows where confidence >= CONFIDENCE_THRESHOLD
    and label != BENIGN (if skip_benign=True)
    """

    print(f"\n  Loading CSV: {csv_path}")

    # Load file
    try:
        df = pd.read_csv(csv_path, encoding="utf-8", low_memory=False)
    except UnicodeDecodeError:
        df = pd.read_csv(csv_path, encoding="latin-1", low_memory=False)

    df.columns = df.columns.str.strip()
    print(f"  Rows loaded: {len(df):,}")

    # Limit rows if specified
    if max_rows:
        df = df.head(max_rows)
        print(f"  Processing first {max_rows} rows only")

    # Preprocess
    X, available = preprocess(df)

    # Run predictions
    print(f"  Running predictions...")
    y_pred  = model.predict(X)
    y_proba = model.predict_proba(X)
    confs   = np.max(y_proba, axis=1)
    labels  = le.inverse_transform(y_pred)

    # Build results list
    results = []
    skipped_benign     = 0
    skipped_confidence = 0

    for i in range(len(df)):
        label      = labels[i]
        confidence = float(confs[i])

        # Skip low confidence predictions
        if confidence < CONFIDENCE_THRESHOLD:
            skipped_confidence += 1
            continue

        # Skip benign traffic if requested
        if skip_benign and label == "BENIGN":
            skipped_benign += 1
            continue

        # Build features dict for this row
        features = {col: df.iloc[i][col] for col in available if col in df.columns}

        results.append({
            "features"  : features,
            "label"     : label,
            "confidence": confidence,
            "row_index" : i
        })

    print(f"  Predictions complete:")
    print(f"    Total rows         : {len(df):,}")
    print(f"    Attacks detected   : {len(results):,}")
    print(f"    Skipped (BENIGN)   : {skipped_benign:,}")
    print(f"    Skipped (low conf) : {skipped_confidence:,}")

    return results


# ─────────────────────────────────────────────────────────────
#  PREDICT SINGLE ROW
#  For when you want to predict one row at a time
#  rather than a full CSV
# ─────────────────────────────────────────────────────────────

def predict_single_row(features: dict, model, le) -> tuple:
    """
    Predicts attack label and confidence for a single feature dict.
    Returns (label, confidence)
    """
    input_df = pd.DataFrame([features])
    input_df.columns = input_df.columns.str.strip()

    available = [c for c in SELECTED_FEATURES if c in input_df.columns]

    # Fill any missing columns with 0
    for col in SELECTED_FEATURES:
        if col not in input_df.columns:
            input_df[col] = 0

    input_df = input_df[SELECTED_FEATURES]
    input_df.replace([np.inf, -np.inf], np.nan, inplace=True)
    input_df.fillna(0, inplace=True)

    proba      = model.predict_proba(input_df)[0]
    pred_class = int(np.argmax(proba))
    confidence = float(proba[pred_class])
    label      = le.classes_[pred_class]

    return label, confidence


